{
  "name": "sorting-algorithm-walkthroughs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/**/*.{svelte,ts,js,css}\"",
    "format:check": "prettier --check \"src/**/*.{svelte,ts,js,css}\"",
    "test:architecture": "node scripts/verify-architecture.mjs",
    "test:architecture-ui": "node scripts/verify-architecture-ui.mjs",
    "test:navigation": "node scripts/verify-navigation.mjs",
    "test:appearance": "node scripts/verify-appearance.mjs",
    "test:light-themes": "node scripts/verify-light-themes.mjs",
    "test:features": "node scripts/verify-features.mjs",
    "test:problems": "node scripts/verify-problem-models.mjs && node scripts/verify-problems.mjs",
    "test:implementation-models": "node scripts/sync-implementations.mjs --check && node scripts/verify-implementation-models.mjs",
    "test:implementations": "node scripts/verify-implementations.mjs",
    "sync:implementations": "node scripts/sync-implementations.mjs",
    "test:domain-landings": "node scripts/verify-domain-landings.mjs",
    "predev": "npm run sync:implementations && npm run build:motion",
    "dev": "vite",
    "build": "npm run sync:implementations && npm run build:motion && vite build",
    "build:motion": "vite build --config vite.motion.config.js",
    "preview": "vite preview",
    "test:walkthroughs": "node scripts/verify-walkthroughs.mjs",
    "test:play": "node scripts/verify-play-models.mjs && node scripts/verify-play.mjs && node scripts/verify-sorting-play.mjs && node scripts/verify-selection-play.mjs && node scripts/verify-player-pattern.mjs",
    "render:films": "node scripts/render-films.mjs",
    "test:film-cache": "node scripts/verify-film-cache.mjs",
    "test:film-rendering": "node scripts/verify-film-rendering.mjs",
    "generate:narration": "node scripts/generate-echo-narration.mjs",
    "test:narration": "node scripts/verify-recorded-narration.mjs && node scripts/verify-echo-narration.mjs",
    "test:study": "node scripts/verify-study.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.1",
    "vite": "8.3.1"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "motion": "^13.4.6"
  }
}
